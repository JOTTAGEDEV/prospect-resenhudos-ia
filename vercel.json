{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w @jotage/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/descobrir", "destination": "/index.html" },
    { "source": "/leads/:path*", "destination": "/index.html" },
    { "source": "/analises", "destination": "/index.html" },
    { "source": "/pipeline", "destination": "/index.html" },
    { "source": "/mensagens", "destination": "/index.html" },
    { "source": "/atividades", "destination": "/index.html" },
    { "source": "/configuracoes", "destination": "/index.html" }
  ]
}
