{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w @jotage/web && npx tsx scripts/cloud-setup.ts",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "destination": "/api/worker",
      "source": "/api/worker"
    },
    {
      "destination": "/api/index?__route=:path*",
      "source": "/api/:path*"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/descobrir",
      "destination": "/index.html"
    },
    {
      "source": "/leads/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/analise",
      "destination": "/index.html"
    },
    {
      "source": "/pipeline",
      "destination": "/index.html"
    },
    {
      "source": "/mensagens",
      "destination": "/index.html"
    },
    {
      "source": "/atividades",
      "destination": "/index.html"
    },
    {
      "source": "/configuracoes",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "packages/shared/package.json"
    },
    "api/worker.ts": {
      "experimentalTriggers": [
        {
          "topic": "prospect-jobs",
          "type": "queue/v2beta"
        }
      ],
      "includeFiles": "packages/shared/package.json",
      "maxDuration": 120
    }
  }
}
